# Required for Gemini structured speech analytics.
# Never commit your real .env file to version control.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=your_supported_gemini_model

# Local OpenAI Whisper configuration (runs locally; audio is never sent to Gemini).
WHISPER_MODEL=base
WHISPER_DEVICE=auto

# Default directory for exported JSON and CSV reports.
OUTPUT_DIR=results
